      "classification": {
        "type": "definition",
        "normativeCategory": "definitional",
        "summary": "Hersteller ist eine natürliche oder juristische Person, auf die eine der beiden Alternativen nach Artikel 3 Nummer 18 zutrifft."
      },
      "definition": {
        "term": "Hersteller",
        "text": "„Hersteller“ bezeichnet jede natürliche oder juristische Person, die Produkte, die in den Anwendungsbereich dieser Verordnung fallen, herstellt bzw. konstruieren oder herstellen lässt und diese Produkte unter ihrem Namen oder ihrer eigenen Handelsmarke vertreibt oder Produkte, die in den Anwendungsbereich dieser Verordnung fallen, herstellt und diese Produkte für den Eigengebrauch in Betrieb nimmt.",
        "condition": {
          "kind": "any",
          "conditions": [
            {
              "kind": "all",
              "conditions": [
                { "kind": "comparison", "fact": "manufacturesOrHasManufacturedInScopeProduct", "operator": "==", "value": true, "valueType": "boolean" },
                { "kind": "comparison", "fact": "marketsProductUnderOwnNameOrTrademark", "operator": "==", "value": true, "valueType": "boolean" }
              ]
            },
            {
              "kind": "all",
              "conditions": [
                { "kind": "comparison", "fact": "manufacturesInScopeProduct", "operator": "==", "value": true, "valueType": "boolean" },
                { "kind": "comparison", "fact": "putsProductIntoServiceForOwnUse", "operator": "==", "value": true, "valueType": "boolean" }
              ]
            }
          ]
        }
      },
      "review": {
        "status": "draft",
        "machineCheckable": false,
        "checkMethods": ["manual"],
        "notes": ["Definition requires legal interpretation to determine concept boundaries."]
      }
    },
