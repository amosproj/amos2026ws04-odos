@prefix ex: <https://example.org/amos/mbo#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:roof_too_far a ex:EscapeWindow ;
    ex:clearHeightM 1.20 ;
    ex:clearWidthM 0.90 ;
    ex:heightAboveFloorM 1.20 ;
    ex:inRoofSlopeOrRoofStructure true ;
    ex:lowerEdgeHorizontalDistanceToEavesM 1.01 .

