{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/amosproj/amos2026ws04-odos/schemas/odos-legal-json/2.0/legal-document.schema.json",
  "$defs": {
    "Footnote": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "marker": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Marker"
        },
        "number": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Number"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "pages": {
          "items": {
            "type": "integer"
          },
          "title": "Pages",
          "type": "array"
        },
        "content": {
          "items": {
            "$ref": "#/$defs/Node"
          },
          "title": "Content",
          "type": "array"
        },
        "anchorElementIds": {
          "description": "the elements the footnote belongs to, set only when source evidence establishes them",
          "items": {
            "type": "string"
          },
          "title": "Anchorelementids",
          "type": "array"
        },
        "references": {
          "description": "each printed reference mark",
          "items": {
            "$ref": "#/$defs/FootnoteReference"
          },
          "title": "References",
          "type": "array"
        }
      },
      "required": [
        "id"
      ],
      "title": "Footnote",
      "type": "object"
    },
    "FootnoteReference": {
      "additionalProperties": false,
      "properties": {
        "elementId": {
          "title": "Elementid",
          "type": "string"
        },
        "marker": {
          "title": "Marker",
          "type": "string"
        },
        "page": {
          "title": "Page",
          "type": "integer"
        }
      },
      "required": [
        "elementId",
        "marker",
        "page"
      ],
      "title": "FootnoteReference",
      "type": "object"
    },
    "Identifiers": {
      "additionalProperties": false,
      "properties": {
        "documentNumber": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Documentnumber"
        },
        "publicationJournal": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Publicationjournal"
        },
        "publicationReference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Publicationreference"
        },
        "citation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Citation"
        }
      },
      "title": "Identifiers",
      "type": "object"
    },
    "LegalSentence": {
      "additionalProperties": false,
      "description": "A legal sentence as ordered text ranges, possibly across several nodes (an Absatz, its list items and the\ntext after the list). Text is never repeated: read it from the referenced nodes.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "unitId": {
          "title": "Unitid",
          "type": "string"
        },
        "number": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "only when the document prints the Satz number",
          "title": "Number"
        },
        "marker": {
          "anyOf": [
            {
              "$ref": "#/$defs/TextRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "where the printed number stands"
        },
        "ranges": {
          "items": {
            "$ref": "#/$defs/TextRange"
          },
          "title": "Ranges",
          "type": "array"
        }
      },
      "required": [
        "id",
        "unitId",
        "ranges"
      ],
      "title": "LegalSentence",
      "type": "object"
    },
    "Node": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "the element id of the DocumentModel (stable, unique)",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "part",
            "title",
            "chapter",
            "division",
            "subdivision",
            "section",
            "article",
            "subsection",
            "paragraph",
            "sentence",
            "number",
            "letter",
            "point",
            "subpoint",
            "numeral",
            "annex",
            "heading",
            "text",
            "item",
            "table",
            "picture",
            "preamble",
            "preambleFormula",
            "citation",
            "recitalsIntro",
            "recital",
            "enactingFormula",
            "conclusions",
            "finalFormula",
            "signature",
            "frontMatter",
            "documentTitle",
            "tableOfContents",
            "tocEntry"
          ],
          "title": "Type",
          "type": "string"
        },
        "nativeType": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "term of the source legal tradition",
          "title": "Nativetype"
        },
        "germanType": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "German name of the legal structural element",
          "title": "Germantype"
        },
        "number": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Number"
        },
        "marker": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "exact marker as printed",
          "title": "Marker"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the element's own text, without marker, title or children",
          "title": "Text"
        },
        "numRows": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Numrows"
        },
        "numCols": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Numcols"
        },
        "rows": {
          "anyOf": [
            {
              "items": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "table cell texts, row by row",
          "title": "Rows"
        },
        "pages": {
          "description": "PDF pages the element is printed on",
          "items": {
            "type": "integer"
          },
          "title": "Pages",
          "type": "array"
        },
        "children": {
          "items": {
            "$ref": "#/$defs/Node"
          },
          "title": "Children",
          "type": "array"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "title": "Node",
      "type": "object"
    },
    "TextRange": {
      "additionalProperties": false,
      "description": "[start, end) in Python str indices (Unicode code points) into the `text` of node `elementId` in this file.",
      "properties": {
        "elementId": {
          "title": "Elementid",
          "type": "string"
        },
        "start": {
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "title": "End",
          "type": "integer"
        }
      },
      "required": [
        "elementId",
        "start",
        "end"
      ],
      "title": "TextRange",
      "type": "object"
    },
    "TocEntryOut": {
      "additionalProperties": false,
      "description": "One logical TOC line, rebuilt from the raw tableOfContents nodes (which stay unchanged).",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "marker": {
          "title": "Marker",
          "type": "string"
        },
        "number": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Number"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "level": {
          "title": "Level",
          "type": "integer"
        },
        "targetElementId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "only for a confirmed link",
          "title": "Targetelementid"
        },
        "ranges": {
          "items": {
            "$ref": "#/$defs/TocTextRange"
          },
          "title": "Ranges",
          "type": "array"
        }
      },
      "required": [
        "id",
        "kind",
        "marker",
        "level",
        "ranges"
      ],
      "title": "TocEntryOut",
      "type": "object"
    },
    "TocTextRange": {
      "additionalProperties": false,
      "description": "[start, end) into the text of a tableOfContents node (or of one of its table cells).",
      "properties": {
        "elementId": {
          "description": "a node of tableOfContents",
          "title": "Elementid",
          "type": "string"
        },
        "cell": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "[row, col] when the text is in a table cell",
          "title": "Cell"
        },
        "start": {
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "title": "End",
          "type": "integer"
        }
      },
      "required": [
        "elementId",
        "start",
        "end"
      ],
      "title": "TocTextRange",
      "type": "object"
    },
    "Version": {
      "additionalProperties": false,
      "properties": {
        "statement": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Statement"
        },
        "date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date"
        }
      },
      "title": "Version",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schemaversion",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "title": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Title"
    },
    "shortTitle": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Shorttitle"
    },
    "documentType": {
      "enum": [
        "de_legislation",
        "eu_regulation",
        "eu_directive",
        "eu_decision",
        "eu_legislation",
        "technical_standard"
      ],
      "title": "Documenttype",
      "type": "string"
    },
    "nativeDocumentType": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Nativedocumenttype"
    },
    "legalSystem": {
      "enum": [
        "de",
        "eu"
      ],
      "title": "Legalsystem",
      "type": "string"
    },
    "language": {
      "title": "Language",
      "type": "string"
    },
    "version": {
      "$ref": "#/$defs/Version"
    },
    "publicationDate": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Publicationdate"
    },
    "adoptionDate": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Adoptiondate"
    },
    "enactmentDate": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Enactmentdate"
    },
    "subject": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Subject"
    },
    "identifiers": {
      "$ref": "#/$defs/Identifiers"
    },
    "pageCount": {
      "title": "Pagecount",
      "type": "integer"
    },
    "frontMatter": {
      "items": {
        "$ref": "#/$defs/Node"
      },
      "title": "Frontmatter",
      "type": "array"
    },
    "tableOfContents": {
      "items": {
        "$ref": "#/$defs/Node"
      },
      "title": "Tableofcontents",
      "type": "array"
    },
    "structure": {
      "items": {
        "$ref": "#/$defs/Node"
      },
      "title": "Structure",
      "type": "array"
    },
    "footnotes": {
      "items": {
        "$ref": "#/$defs/Footnote"
      },
      "title": "Footnotes",
      "type": "array"
    },
    "tableOfContentsEntries": {
      "items": {
        "$ref": "#/$defs/TocEntryOut"
      },
      "title": "Tableofcontentsentries",
      "type": "array"
    },
    "sentences": {
      "items": {
        "$ref": "#/$defs/LegalSentence"
      },
      "title": "Sentences",
      "type": "array"
    }
  },
  "required": [
    "id",
    "title",
    "documentType",
    "legalSystem",
    "language",
    "version",
    "identifiers",
    "pageCount",
    "frontMatter",
    "tableOfContents",
    "structure",
    "footnotes"
  ],
  "title": "LegalDocument",
  "type": "object"
}
