			<longTitle xml:id="d2e117">
				<p xml:id="d2e119"><docType xml:id="d2e120" refersTo="~RES_DRAFT_COR">DRAFT RESOLUTION</docType>
					<docPurpose xml:id="d2e123">on the 2019 European Semester and in view of the 2020 Annual Growth
						Survey</docPurpose></p>
			</longTitle>
			<container xml:id="d2e127" name="docProponents">
				<p xml:id="d2e129">Submitted by the <organization xml:id="d2e131" refersTo="~COR_GROUP_EPP">EPP</organization>,
					<organization xml:id="d2e134" refersTo="~COR_GROUP_PES">PES</organization>, <organization xml:id="d2e137" refersTo="~COR_GROUP_RENEW">Renew Europe</organization>, <organization xml:id="d2e140" refersTo="~COR_GROUP_EA">EA</organization> and <organization xml:id="d2e143" refersTo="~COR_GROUP_ECR">ECR</organization> political groups</p>
			</container>
			<container xml:id="d2e148" name="procedureInstruction">
				<p xml:id="d2e150"><inline xml:id="d2e151" name="label">Deadline for tabling amendments:</inline>
					<date xml:id="d2e154" date="2019-09-20">20 September 2019</date> no later than <time xml:id="d2e157" time="15:00:00">3 p.m., Brussels time</time>
				</p>
				<p xml:id="d2e161">Amendments to the resolution are to be submitted, preferably in English, French
					or German, through the online tool for tabling amendments (available on the
					Members' Portal: <a xml:id="d2e163" href="https://memportal.cor.europa.eu/)">https://memportal.cor.europa.eu/)</a>. </p>
				<p xml:id="d2e167">The Helpdesk (+32 (0)2 546 96 97, email: helpdesk@cor.europa.eu) is at your
					disposal to provide you with any assistance you may need. In addition, a user
					guide is available at <a xml:id="d2e169" href="https://memportal.cor.europa.eu/">https://memportal.cor.europa.eu/</a>
				</p>
				<p xml:id="d2e173"><inline xml:id="d2e174" name="label">Number of signatures required:</inline> 6 </p>
