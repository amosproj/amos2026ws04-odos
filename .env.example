# Copy to .env and choose a local password. Never commit .env.
# Read by Docker Compose (compose.yaml) and, when exported, by the ODOS backend.
POSTGRES_USER=odos
POSTGRES_PASSWORD=replace_with_local_password
POSTGRES_DB=odos

# Backend connection (defaults shown); compose.yaml publishes PostgreSQL on 127.0.0.1:5433
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
