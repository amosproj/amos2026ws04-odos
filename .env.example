# Copy to .env and choose a local password. Never commit .env.
# Read by Docker Compose (compose.yaml) and, when exported, by the ODOS backend.
POSTGRES_USER=odos
POSTGRES_PASSWORD=replace_with_local_password
POSTGRES_DB=odos

# Backend connection (defaults shown); compose.yaml publishes PostgreSQL on 127.0.0.1:5433
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# Amazon Bedrock for LLM rule extraction (optional; see Documentation/bedrock-rule-extraction.md).
# Create a Bedrock API key in the AWS console (Amazon Bedrock > API keys) and paste it here. Never commit it.
AWS_BEARER_TOKEN_BEDROCK=
ODOS_BEDROCK_REGION=eu-central-1
# In eu-central-1 Claude Sonnet 4.6 needs an inference profile ID (the base ID anthropic.claude-sonnet-4-6 is not offered in-region).
# eu.* keeps requests inside the EU; global.anthropic.claude-sonnet-4-6 may be routed outside it.
ODOS_BEDROCK_MODEL_ID=eu.anthropic.claude-sonnet-4-6
# Optional limits (defaults shown):
# ODOS_BEDROCK_MAX_TOKENS=32000
# ODOS_BEDROCK_TEMPERATURE=0
# ODOS_BEDROCK_CONNECT_TIMEOUT_SECONDS=10
# ODOS_BEDROCK_READ_TIMEOUT_SECONDS=600
# ODOS_BEDROCK_MAX_ATTEMPTS=3
# ODOS_BEDROCK_CONTEXT_TOKENS=1000000
# extra model calls when an answer is not valid JSON: 0 or 1 (each is a paid call; more than 1 is refused)
# ODOS_BEDROCK_OUTPUT_RETRIES=1
# where unusable model answers are kept for diagnosis by the CLI (private files; default ~/.cache/odos/llm-diagnostics)
# ODOS_LLM_DIAGNOSTICS_DIR=
# API: rule extractions allowed to wait or run at once (each is a paid call)
# ODOS_RULE_EXTRACTION_MAX_QUEUED=3
